# Activates the MSW mock layer. Keep "true" for development, demo and tests —
# the application has no real backend by design (see ARCHITECTURE.md).
VITE_ENABLE_MOCKS=true

# Default mock scenario applied on a cold start. Can be overridden at runtime
# with the ?scenario= search param. See src/mocks/scenarios.
VITE_MOCK_SCENARIO=default

# Base URL the Axios client prefixes onto every REST call. Served by MSW.
VITE_API_BASE_URL=/api

# Socket.IO endpoint. Served by the MSW Socket.IO binding in the mock layer.
VITE_SOCKET_URL=/socket.io
